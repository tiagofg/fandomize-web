# ----------------------------------------
# Projetos Node / Next.js – padrão monorepo
# ----------------------------------------

# Dependências (npm, pnpm, Yarn workspaces)
node_modules/

# Build / bundles
dist/
build/
.next/
out/

# Arquivos de lock extras (caso use apenas um gerenciador)
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tgz

# Variáveis de ambiente
.env*
!.env.example      # deixa apenas o template de exemplo rastreado

# Logs de testes ou cobertura
coverage/
*.lcov

# IDE / SO
.vscode/
.idea/
.DS_Store

# Cache de Husky v8- (o v9 não gera mais esses arquivos)
.husky/_/
node_modules/
