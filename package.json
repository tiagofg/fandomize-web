{
  "name": "fandomize-monorepo",
  "private": true,
  "workspaces": [
    "fandomize"
  ],
  "scripts": {
    "prepare": "husky || true"
  },
  "devDependencies": {
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "next": "^15.2.4",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,!(*node_modules|*.next|dist)/**}": [
      "eslint --fix",
      "prettier --write",
      "npm run --workspace fandomize test -- --findRelatedTests --bail --passWithNoTests"
    ],
    "*.{json,md,css,scss,!(*node_modules|*.next|dist)/**}": "prettier --write"
  }
}
